{
	"geode": "5.8.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "dominodev.fivefive",
	"name": "FIVE-FIVE",
	"version": "v1.2.0",
	"developer": "dominodev",
	"description": "funny kingsammelot number go brr",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"prevter.imageplus": ">=v1.1.0",
		"fryy_55.amber": {
			"version": ">=2.0.0",
			"required": true
    	}

	},

	"resources": {
		"files": [
			"resources/fivefive.mp3",
			"resources/fivefive.webp",
			"resources/phobos.mp3",
			"resources/phobos.webp",
			"resources/fourtrucks.png",
			"resources/samme.png",
			"resources/fortrocks.jpg",
			"resources/boom.mp3"
			
		]
	},

	"settings": {
		"onlyondeath":{
			"type": "bool",
			"default": false,
			"description": "If to only do the 55 if you die at 55%",
			"name": "Only On Death"
		},

		"volume":{
			"type": "float",
			"default": 1.0,
			"max": 1.0,
			"min": 0,
			"control": {
				"arrows": true,
				"arrow-step": 0.1,
				"slider": true,
				"input": true
			},
			"name": "Volume"
		},

		"fullscreen":{
			"type": "bool",
			"default": false,
			"name": "Play Fullscreen",
			"description": "Whether or not to play the video in full screen."
		},

		"mobilebutton": {
			"type": "bool",
			"default": false,
			"name": "Hide Mobile Button",
			"description": "hides button to skip animation on mobile"
		},

		"vortrox": {
			"type": "bool",
			"default": false,
			"name": "Vortrox Mode",
			"description": "makes vortrox play if you die at 98%",
			"enable-if": "onlyondeath"
		}
	},

	"tags": ["joke"],

	"links": {"source": "https://github.com/DominoKiddoo/fivefive-gdmod"}


}
